{
  "name": "benchly",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "build": "npm run data:catalog:check && npm run db:migrate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "data:refresh": "uv run python worker/benchly_worker.py refresh",
    "statistics:population:update": "tsx scripts/update-municipality-population.ts",
    "statistics:external:update": "tsx scripts/update-statistics-external.ts",
    "test:worker": "uv run pytest",
    "test:worker:container": "docker build --target test -f worker/Dockerfile .",
    "data:catalog:generate": "tsx scripts/generate-data-jobs.ts",
    "data:catalog:check": "tsx scripts/generate-data-jobs.ts --check && npm run dialects:check",
    "dialects:generate": "tsx scripts/generate-dialect-packs.ts",
    "dialects:check": "tsx scripts/generate-dialect-packs.ts --check",
    "dialects:geography:generate": "uv run python scripts/generate_dialect_geography.py",
    "dialects:audit": "uv run python scripts/audit_dialect_coverage.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@formatjs/intl-numberformat": "^9.4.0",
    "@formatjs/intl-pluralrules": "^6.3.13",
    "@next/env": "16.3.4",
    "@tailwindcss/postcss": "^4.1.14",
    "better-sqlite3": "^12.4.1",
    "daisyui": "^5.1.30",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "6.9.0",
    "next": "^16.0.0",
    "next-intl": "^4.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "suncalc": "^2.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
